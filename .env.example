# Exchange Configuration
EXCHANGE_NAME=paper
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=True
ALPACA_API_URL=https://paper-api.alpaca.markets

# Paper Trading Validation
PAPER_CURRENCY=IDR
PAPER_INITIAL_BALANCE_IDR=10000000
PAPER_SYMBOL=BTC-IDR
PAPER_MAX_OPEN_POSITIONS=3

# Dashboard-selected Indodax credentials are encrypted at runtime; do not put them here.

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading
# DATABASE_URL=sqlite:///./data/trading.db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT / Dashboard Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# External FastAPI Cloud AI Engine
# Optional compute only. It must never become a second trading brain.
AI_ENGINE_URL=https://your-fastapi-cloud-app.example
AI_ENGINE_SHARED_SECRET=replace_with_a_random_secret_at_least_32_chars

# Optional Sentiment Context
# Leave unset when unavailable; the agent reports UNAVAILABLE rather than inventing data.
NEWS_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Deterministic Risk Management
MAX_POSITION_SIZE=0.20
DAILY_LOSS_LIMIT=0.05
MAX_OPEN_POSITIONS=3

# Canonical Trader / Opportunity Policy
TRADER_MIN_CANDIDATE_SCORE=0.55
TRADER_MIN_CONFIDENCE=0.60
TRADER_EXECUTION_CONFIDENCE=0.75
TRADER_MIN_CONFIRMATIONS=2
TRADER_MAX_CONFLICT=0.45

# Short-Horizon Forecast
FORECAST_SHORT_BARS=3
FORECAST_MEDIUM_BARS=8
FORECAST_LONG_BARS=15

# Market Data Quality
MARKET_DATA_MAX_AGE_SECONDS=90

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# VPS Settings
VPS_HOST=your_vps_ip
VPS_USER=deployer
REMOTE_APP_PATH=/home/deployer/ai-trading-bot

# Frontend
REACT_APP_API_URL=http://localhost:8000
