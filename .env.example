# FastAPI
APP_NAME=Compound Scalping API
APP_VERSION=2.1.0
CORS_ORIGINS=https://YOUR-USERNAME.github.io
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Supabase browser-safe values
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase server-only values
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# You may use DATABASE_URL instead of SUPABASE_DB_URL on hosting platforms.
SUPABASE_DB_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR_DATABASE_PASSWORD@YOUR-POOLER-HOST:5432/postgres
BOT_OWNER_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID

# Public market-data source for paper trading. No API key/secret required.
EXCHANGE_NAME=bybit
TRADING_MODE=paper
BOT_NAME=compound-scalper
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/USDT
STAKE_CURRENCY=USDT
STAKE_AMOUNT=100
PAPER_INITIAL_BALANCE=1000
MAX_OPEN_TRADES=1
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30

# Do NOT put exchange secrets, database passwords, or the Supabase service-role key in public/.
