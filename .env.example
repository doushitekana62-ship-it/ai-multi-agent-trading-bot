# FastAPI / static frontend
APP_NAME=Compound Scalping API
APP_VERSION=2.0.0
# Origin only: do not include a path such as /YOUR-REPOSITORY
CORS_ORIGINS=https://doushitekana62-ship-it.github.io
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Persistent PostgreSQL connection used by Freqtrade. Prefer the Supabase Session pooler
# for IPv4-only hosts, or Direct connection when the server supports IPv6.
SUPABASE_DB_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR_DATABASE_PASSWORD@YOUR-POOLER-HOST:5432/postgres
BOT_OWNER_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID

# Indodax credentials - NEVER put these in public/static JavaScript
EXCHANGE_NAME=indodax
INDODAX_API_KEY=
INDODAX_API_SECRET=

# Trading safety: keep paper until testing is complete
TRADING_MODE=paper
BOT_NAME=compound-scalper
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/IDR
STAKE_CURRENCY=IDR
STAKE_AMOUNT=100000
PAPER_INITIAL_BALANCE=1000000
MAX_OPEN_TRADES=1
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30
