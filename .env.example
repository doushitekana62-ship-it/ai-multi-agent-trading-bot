# Exchange Configuration
EXCHANGE_NAME=paper
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=True
ALPACA_API_URL=https://paper-api.alpaca.markets

# Dashboard-selected Indodax credentials are encrypted at runtime; do not put them here.

# Supabase (server-side only)
# Use the project URL shown in Supabase settings.
SUPABASE_URL=https://opclkckfdlkqzunzmwym.supabase.co
# Never expose this key to the React frontend.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# SUPABASE_KEY=legacy_fallback_key

# Database / local development
DATABASE_URL=postgresql://postgres:postgres@db:5432/trading
# DATABASE_URL=sqlite:///./data/trading.db

# CORS
# In production, set this to the Cloudflare dashboard origin, e.g.
# CORS_ORIGINS=https://ai-multi-agent-trading-dashboard.<account>.workers.dev
CORS_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://redis:6379/0

# JWT / Dashboard Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password

# API Keys for Sentiment
NEWS_API_KEY=your_news_api_key_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Risk Management
MAX_POSITION_SIZE=0.20
DAILY_LOSS_LIMIT=0.05
MAX_OPEN_POSITIONS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# VPS Settings
VPS_HOST=your_vps_ip
VPS_USER=deployer
REMOTE_APP_PATH=/home/deployer/ai-trading-bot

# Frontend
# Leave empty when the dashboard is deployed behind the Cloudflare Worker proxy.
REACT_APP_API_URL=
