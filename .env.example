# FastAPI
APP_NAME=Compound Scalping API
APP_VERSION=2.3.0
CORS_ORIGINS=https://YOUR-USERNAME.github.io
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Supabase browser-safe values
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase server-only values
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# For this long-running backend use the direct connection when IPv6 is available,
# otherwise use Supavisor session mode (port 5432), not transaction mode (6543).
SUPABASE_DB_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR_DATABASE_PASSWORD@YOUR-POOLER-HOST:5432/postgres
BOT_OWNER_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID

# Indodax server-side trading configuration
EXCHANGE_NAME=indodax
TRADING_MODE=paper
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Keep false until compatibility, reconciliation, and paper tests are complete.
LIVE_TRADING_ENABLED=false

BOT_NAME=compound-scalper
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/IDR
STAKE_CURRENCY=IDR
STAKE_AMOUNT=100000
PAPER_INITIAL_BALANCE=1000000
MAX_OPEN_TRADES=1
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30
RUNTIME_RESTART_ENABLED=false
RUNTIME_RESTART_DELAY=30

# Never put exchange secrets, database passwords, or the Supabase service-role key in public/.
