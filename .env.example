# FastAPI
APP_NAME=Compound Scalping API
APP_VERSION=2.4.0
CORS_ORIGINS=https://YOUR-USERNAME.github.io
LOG_LEVEL=INFO
LOG_DIR=/tmp/compound-scalping
DASHBOARD_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_TOKEN

# FastAPI Cloud writable local SQLite path
FREQTRADE_DB_PATH=/tmp/compound-scalping/tradesv3.sqlite

# Indodax server-side trading configuration
EXCHANGE_NAME=indodax
TRADING_MODE=paper
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Keep false until compatibility, reconciliation, and paper tests are complete.
LIVE_TRADING_ENABLED=false

BOT_NAME=compound-scalper
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/IDR
STAKE_CURRENCY=IDR
STAKE_AMOUNT=100000
PAPER_INITIAL_BALANCE=1000000
MAX_OPEN_TRADES=1
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30
RUNTIME_RESTART_ENABLED=false
RUNTIME_RESTART_DELAY=30

# Never put DASHBOARD_TOKEN or exchange secrets in public/.
