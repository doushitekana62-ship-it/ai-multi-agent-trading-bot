# FastAPI
APP_NAME=Compound Scalping API
APP_VERSION=2.5.0
CORS_ORIGINS=https://doushitekana62-ship-it.github.io
LOG_LEVEL=INFO
LOG_DIR=./logs
DASHBOARD_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_TOKEN

# Persistent local SQLite path. Docker Compose mounts ./data to /app/data.
FREQTRADE_DB_PATH=/app/data/tradesv3.sqlite

# Indodax server-side trading configuration
EXCHANGE_NAME=indodax
TRADING_MODE=paper
INDODAX_API_KEY=
INDODAX_API_SECRET=
LIVE_TRADING_ENABLED=false

BOT_NAME=compound-scalper
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/IDR
STAKE_CURRENCY=IDR
STAKE_AMOUNT=100000
PAPER_INITIAL_BALANCE=1000000
MAX_OPEN_TRADES=1
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30
RUNTIME_RESTART_ENABLED=true
RUNTIME_RESTART_DELAY=30

# Optional dedicated JWT secret. Use a random value >= 32 characters in production.
FREQTRADE_JWT_SECRET=

# Never put DASHBOARD_TOKEN or exchange secrets in public/.
