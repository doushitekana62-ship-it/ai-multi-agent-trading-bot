# Mirei Android-first migration: legacy FastAPI variables remain for compatibility.
# Do not put real secrets in this file.

# Legacy / optional FastAPI
APP_NAME=Mirei ミレイ API
APP_VERSION=3.0.0
CORS_ORIGINS=
LOG_LEVEL=INFO
LOG_DIR=./logs
DASHBOARD_TOKEN=
FREQTRADE_DB_PATH=/app/data/tradesv3.sqlite
FREQTRADE_API_PORT=8080
FREQTRADE_JWT_SECRET=
FREQTRADE_INTERNAL_PASSWORD=

# Exchange adapter (legacy server runtime; Android will use secure local storage)
EXCHANGE_NAME=indodax
SUPPORTED_EXCHANGES=indodax,bybit
TRADING_MODE=paper
INDODAX_API_KEY=
INDODAX_API_SECRET=
INDODAX_WS_TOKEN=
BYBIT_API_KEY=
BYBIT_API_SECRET=
LIVE_TRADING_ENABLED=false

# Mirei trading defaults
BOT_NAME=mirei
FREQTRADE_STRATEGY=CompoundScalpingStrategy
TRADING_PAIRS=BTC/IDR
STAKE_CURRENCY=IDR
STAKE_AMOUNT=50000
TOTAL_INITIAL_BALANCE=150000
PAPER_INITIAL_BALANCE=150000
MAX_OPEN_TRADES=3
TIMEFRAME=1m
PROCESS_THROTTLE_SECS=5
HEARTBEAT_INTERVAL=30

# Risk defaults; user-configurable values belong in Mirei local settings.
BASE_STOPLOSS_PERCENT=0.5
BASE_TAKE_PROFIT_PERCENT=1.0
SENTIMENT_HOLD_THRESHOLD=-30

# Runtime compatibility
AUTO_START_TRADING=false
RUNTIME_RESTART_ENABLED=true
RUNTIME_RESTART_DELAY=30

# Never put exchange secrets in public/ or commit real .env values.
