{
  "name": "ai-trading-dashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "axios": "1.20.0",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1",
    "@mui/material": "5.18.0",
    "@mui/icons-material": "5.18.0",
    "@mui/utils": "5.17.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "react-hot-toast": "2.6.0",
    "react-hook-form": "7.87.0",
    "date-fns": "2.30.0",
    "react-scripts": "5.0.1",
    "ajv": "8.20.0",
    "ajv-keywords": "5.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && rm -rf agents core exchange_integration && cp -r ../agents ../core ../exchange_integration .",
    "build:cloudflare": "npm run build && python -m pip install uv && uvx --from workers-py pywrangler sync",
    "deploy": "uvx --from workers-py pywrangler deploy",
    "preview": "uvx --from workers-py pywrangler dev",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "4.9.5",
    "wrangler": "4.127.1"
  },
  "proxy": "http://localhost:8000"
}
