{
  "name": "ai-trading-dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.15",
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "axios": "1.20.0",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1",
    "@mui/material": "5.17.1",
    "@mui/icons-material": "5.17.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "react-hot-toast": "2.6.0",
    "react-hook-form": "7.87.0",
    "date-fns": "2.30.0",
    "react-scripts": "5.0.1",
    "ajv": "8.20.0",
    "ajv-keywords": "5.1.0"
  },
  "overrides": {
    "@mui/core-downloads-tracker": "5.17.1",
    "@mui/private-theming": "5.16.14",
    "@mui/styled-engine": "5.16.14",
    "@mui/system": "5.17.1",
    "@mui/utils": "5.17.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/patch-mui-webpack-compat.js && node scripts/verify-cloudflare-deps.js",
    "build": "react-scripts build && rm -rf agents core exchange_integration && cp -r ../agents ../core ../exchange_integration .",
    "build:cloudflare": "bun run build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "4.9.5",
    "wrangler": "4.127.1"
  },
  "proxy": "http://localhost:8000"
}
