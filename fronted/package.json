{
  "name": "ai-trading-dashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "react-hot-toast": "^2.4.1",
    "react-hook-form": "^7.47.0",
    "date-fns": "^2.30.0",
    "react-scripts": "5.0.1",
    "ajv": "^8.17.1",
    "ajv-keywords": "5.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && rm -rf agents core exchange_integration && cp -r ../agents ../core ../exchange_integration .",
    "build:cloudflare": "npm run build && python -m pip install uv && uvx --from workers-py pywrangler sync",
    "deploy": "uvx --from workers-py pywrangler deploy",
    "preview": "uvx --from workers-py pywrangler dev",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "4.9.5",
    "wrangler": "^4.127.0"
  },
  "proxy": "http://localhost:8000"
}
