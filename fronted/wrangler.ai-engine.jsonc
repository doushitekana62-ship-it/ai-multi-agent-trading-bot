{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-multi-agent-trading-ai-engine",
  "main": "./ai_engine_worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "AiEngineContainer",
      "image": "./ai_engine/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_ENGINE",
        "class_name": "AiEngineContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AiEngineContainer"]
    }
  ]
}
