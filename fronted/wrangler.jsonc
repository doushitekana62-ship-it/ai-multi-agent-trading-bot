{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-multi-agent-trading-dashboard",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
