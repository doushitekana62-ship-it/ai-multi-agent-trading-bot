{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-multi-agent-trading-bot",
  "main": "./worker_entry_resilient.py",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_STATE",
        "class_name": "PaperTradingState"
      }
    ]
  },
  "exports": {
    "PaperTradingState": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": []
  }
}
