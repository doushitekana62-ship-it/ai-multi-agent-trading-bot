{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "compound-scalping-dashboard",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/config"]
  },
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    "FASTAPI_URL": ""
  }
}
